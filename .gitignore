# Deigracht — игнорируемые файлы.
# Правило проекта (регламент §9): .gitignore существует с первого коммита;
# секреты не попадают в git никогда. Список расширяется волнами,
# добавление строки — с комментарием «зачем».

# ОС и файловые менеджеры
.DS_Store
Thumbs.db
desktop.ini

# Логи и временные файлы
*.log
*.tmp
*~

# Редакторы и IDE (локальные настройки не публикуются)
.idea/
.vscode/

# Секреты и локальные конфиги (появятся с кодовыми волнами —
# установленное правило: в репозитории только *.example)
config.local.*
*.secret
.env
.env.*

# Зависимости и сборки (проект без сборки; строка — страховка
# от случайного node_modules при экспериментах с инструментами)
node_modules/

# Локальные черновики аналитика (рабочий каталог не публикуется)
drafts/
